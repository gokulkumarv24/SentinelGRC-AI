# Production environment for deploy/docker-compose.prod.yml. Copy to deploy/production.env (never commit it),
# replace every CHANGE_ME — the API refuses to start while placeholders remain — and prefer injecting
# secrets from your platform's secret manager instead of storing them in this file.

APP_ENV=production
APP_NAME="SentinelGRC AI"
PUBLIC_APP_URL=https://CHANGE_ME.example.com
CORS_ORIGINS=https://CHANGE_ME.example.com
TRUST_PROXY=true
API_PORT=4000
LOG_LEVEL=info

# Least-privilege roles on a private/managed PostgreSQL (TLS required by managed providers); see docs/DEPLOYMENT.md.
# The API and worker use the data-only role; only the release step uses the schema owner.
DATABASE_URL=postgresql://sentinel_app:CHANGE_ME@db.internal:5432/sentinelgrc?sslmode=require
MIGRATION_DATABASE_URL=postgresql://sentinel_owner:CHANGE_ME@db.internal:5432/sentinelgrc?sslmode=require
# 48 random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CHANGE_ME
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# Private object storage (recommended) — bucket versioning on, public access blocked.
STORAGE_BACKEND=s3
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_BUCKET=sentinelgrc-evidence
S3_REGION=auto
S3_ACCESS_KEY_ID_REF=SENTINELGRC_S3_KEY_ID
S3_SECRET_ACCESS_KEY_REF=SENTINELGRC_S3_SECRET
SENTINELGRC_S3_KEY_ID=CHANGE_ME
SENTINELGRC_S3_SECRET=CHANGE_ME
MAX_UPLOAD_SIZE_MB=25
DOWNLOAD_URL_TTL_SECONDS=300

# AI assistant: off until your data-sharing review approves a provider.
AI_ENABLED=false
AI_PROVIDER=mock
AI_DATA_SHARING_APPROVED=false

EMAIL_PROVIDER=none
EMAIL_FROM="SentinelGRC <no-reply@CHANGE_ME.example.com>"

SENTRY_DSN=
DEMO_MODE=false
WORKER_POLL_SECONDS=15

# Used by the compose file itself (not the application).
SENTINELGRC_DOMAIN=CHANGE_ME.example.com
REGISTRY=ghcr.io/CHANGE_ME
SENTINELGRC_VERSION=CHANGE_ME
BACKUP_DATABASE_URL=postgresql://sentinel_backup:CHANGE_ME@db.internal:5432/sentinelgrc?sslmode=require
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
BACKUP_HOST_DIR=/srv/sentinelgrc-backups
# Only with the bundled database profile (`--profile bundled-db`):
POSTGRES_PASSWORD=CHANGE_ME
