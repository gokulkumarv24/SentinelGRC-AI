model ReportRun {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  reportType      String       @map("report_type")
  format          ReportFormat
  title           String
  filters         Json         @default("{}")
  reportStatus    String       @default("draft") @map("report_status") // draft | final
  generatedBy     String?      @map("generated_by") @db.Uuid
  scheduleId      String?      @map("schedule_id") @db.Uuid
  generatedAt     DateTime?    @map("generated_at") @db.Timestamptz(6)
  status          ReportStatus @default(queued)
  storageKey      String?      @map("storage_key")
  checksum        String?
  sizeBytes       Int?         @map("size_bytes")
  sourceRecordIds Json         @default("[]") @map("source_record_ids")
  errorCode       String?      @map("error_code")
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("report_runs")
}

model ReportSchedule {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  reportType       String       @map("report_type")
  format           ReportFormat
  filters          Json         @default("{}")
  frequency        String // daily | weekly | monthly
  recipientUserIds String[]     @map("recipient_user_ids") @db.Uuid
  enabled          Boolean      @default(true)
  nextRunAt        DateTime     @map("next_run_at") @db.Timestamptz(6)
  lastRunAt        DateTime?    @map("last_run_at") @db.Timestamptz(6)
  createdBy        String       @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([enabled, nextRunAt])
  @@map("report_schedules")
}

model AiArtifact {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  requestedBy      String        @map("requested_by") @db.Uuid
  artifactType     String        @map("artifact_type") // evidence_summary | finding_draft | report_draft | vendor_observations | remediation_options | mapping_suggestions | risk_summary | control_failure_explanation
  sourceRecords    Json          @map("source_records") // [{type,id,checksum|version}]
  provider         String
  model            String
  promptVersion    String        @map("prompt_version")
  input            Json // minimized/redacted input actually sent
  output           Json?
  schemaValid      Boolean       @default(false) @map("schema_valid")
  validationErrors Json?         @map("validation_errors")
  limitations      String?
  status           String        @default("draft") // draft | failed
  errorCode        String?       @map("error_code")
  latencyMs        Int?          @map("latency_ms")
  inputTokens      Int?          @map("input_tokens")
  outputTokens     Int?          @map("output_tokens")
  reviewerId       String?       @map("reviewer_id") @db.Uuid
  decision         DraftDecision @default(pending)
  reviewerEdits    Json?         @map("reviewer_edits")
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  usedInRecordType String?       @map("used_in_record_type")
  usedInRecordId   String?       @map("used_in_record_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, artifactType])
  @@map("ai_artifacts")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  scope          String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, key])
  @@map("idempotency_keys")
}
