// SentinelGRC AI — database schema (spec §5).
// Conventions: UUID primary keys; every tenant-owned row carries organizationId;
// timestamps are stored in UTC (timestamptz); statuses are enums; JSON only for
// genuinely flexible payloads. Column @map annotations are added by
// scripts/add-column-maps.mjs so SQL columns are snake_case.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrganizationStatus {
  active
  suspended
  archived
}

enum UserStatus {
  active
  disabled
  pending
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum FrameworkStatus {
  draft
  active
  deprecated
  archived
}

enum ImplementationStatus {
  not_assessed
  planned
  in_progress
  implemented
  partially_implemented
  not_applicable
  retired
}

enum TestResult {
  pass
  fail
  unknown
  error
  not_applicable
}

enum TestType {
  automated
  manual
}

enum MappingType {
  supports
  partially_supports
  related
  requires_separate_evidence
}

enum ReviewStatus {
  unreviewed
  pending_review
  approved
  rejected
}

enum EvidenceClassification {
  public
  internal
  confidential
  restricted
}

enum EvidenceSourceType {
  upload
  integration
  manual_record
  generated_report
}

enum RiskStatus {
  identified
  assessed
  treatment_planned
  in_treatment
  monitoring
  accepted
  closed
}

enum RiskTreatment {
  undecided
  mitigate
  transfer
  avoid
  accept
}

enum Severity {
  low
  medium
  high
  critical
}

enum FindingStatus {
  open
  triaged
  in_remediation
  pending_validation
  closed
  accepted
  reopened
}

enum TaskStatus {
  open
  in_progress
  blocked
  completed
  cancelled
}

enum Priority {
  low
  medium
  high
  urgent
}

enum AcceptanceDecision {
  pending
  approved
  rejected
  expired
  withdrawn
}

enum VendorStatus {
  draft
  onboarding
  assessment_required
  under_review
  approved
  approved_with_conditions
  rejected
  active
  offboarding
  archived
}

enum Criticality {
  low
  medium
  high
  critical
}

enum AccessLevel {
  none
  limited
  privileged
  administrative
}

enum ResponseType {
  yes_no
  single_choice
  multiple_choice
  text
  number
  date
  file
}

enum AssessmentStatus {
  draft
  submitted
  under_review
  returned_for_clarification
  approved
  closed
}

enum ResponseReviewStatus {
  pending
  accepted
  insufficient
  rejected
}

enum AiLifecycleStatus {
  proposed
  under_assessment
  approved_for_pilot
  pilot
  approved_for_production
  production
  suspended
  retired
}

enum AiAssessmentStatus {
  draft
  in_progress
  submitted
  approved
  rejected
  superseded
}

enum AiItemResult {
  not_answered
  satisfactory
  needs_improvement
  unsatisfactory
  not_applicable
}

enum AiRiskTier {
  minimal
  limited
  high
  unacceptable
  undetermined
}

enum IncidentStatus {
  open
  investigating
  mitigated
  resolved
  closed
}

enum LegalReviewStatus {
  not_started
  preliminary
  under_legal_review
  reviewed
}

enum IntegrationStatus {
  not_configured
  configured
  healthy
  degraded
  failing
  disabled
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  partially_succeeded
  cancelled
}

enum DeliveryStatus {
  pending
  delivered
  failed
  suppressed
}

enum ReportStatus {
  queued
  generating
  ready
  failed
  expired
}

enum ReportFormat {
  pdf
  csv
  xlsx
}

enum DraftDecision {
  pending
  accepted
  edited_and_accepted
  rejected
}

// ──────────────────────── Organizations & identity ────────────────────────

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  industry  String?
  timezone  String             @default("UTC")
  status    OrganizationStatus @default(active)
  isDemo    Boolean            @default(false) @map("is_demo")
  settings  Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  invitations Invitation[]

  // generated back-relations
  controlRows                Control[]
  controlMappingRows         ControlMapping[]
  controlMappingHistoryRows  ControlMappingHistory[]
  controlImplementationRows  ControlImplementation[]
  controlTestConfigRows      ControlTestConfig[]
  controlTestRows            ControlTest[]
  evidenceRows               Evidence[]
  evidenceLinkRows           EvidenceLink[]
  evidenceAccessLogRows      EvidenceAccessLog[]
  scoringPolicyRows          ScoringPolicy[]
  riskRows                   Risk[]
  riskLinkRows               RiskLink[]
  riskControlRows            RiskControl[]
  riskHistoryRows            RiskHistory[]
  riskAcceptanceRows         RiskAcceptance[]
  findingRows                Finding[]
  findingEventRows           FindingEvent[]
  remediationTaskRows        RemediationTask[]
  vendorRows                 Vendor[]
  vendorContactRows          VendorContact[]
  assessmentTemplateRows     AssessmentTemplate[]
  vendorAssessmentRows       VendorAssessment[]
  questionResponseRows       QuestionResponse[]
  vendorRiskHistoryRows      VendorRiskHistory[]
  vendorPortalInvitationRows VendorPortalInvitation[]
  aiSystemRows               AiSystem[]
  aiAssessmentRows           AiAssessment[]
  aiAssessmentItemRows       AiAssessmentItem[]
  aiEvaluationRows           AiEvaluation[]
  aiIncidentRows             AiIncident[]
  aiModelChangeRows          AiModelChange[]
  euAiActApplicabilityRows   EuAiActApplicability[]
  integrationRows            Integration[]
  integrationSyncRunRows     IntegrationSyncRun[]
  integrationRecordRows      IntegrationRecord[]
  workflowDefinitionRows     WorkflowDefinition[]
  workflowRunRows            WorkflowRun[]
  notificationRows           Notification[]
  notificationPreferenceRows NotificationPreference[]
  outboxEventRows            OutboxEvent[]
  auditEventRows             AuditEvent[]
  reportRunRows              ReportRun[]
  reportScheduleRows         ReportSchedule[]
  aiArtifactRows             AiArtifact[]
  idempotencyKeyRows         IdempotencyKey[]

  // generated back-relations
  frameworkRows Framework[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique // normalized lowercase
  displayName        String     @map("display_name")
  passwordHash       String?    @map("password_hash")
  externalIdentity   String?    @map("external_identity")
  status             UserStatus @default(active)
  isPlatformAdmin    Boolean    @default(false) @map("is_platform_admin")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]

  // generated back-relations
  invitation_inviterId          Invitation[]            @relation("Invitation_inviterId")
  controlImplementation_ownerId ControlImplementation[] @relation("ControlImplementation_ownerId")
  controlTest_initiatedBy       ControlTest[]           @relation("ControlTest_initiatedBy")
  evidence_ownerId              Evidence[]              @relation("Evidence_ownerId")
  evidence_uploadedBy           Evidence[]              @relation("Evidence_uploadedBy")
  risk_riskOwnerId              Risk[]                  @relation("Risk_riskOwnerId")
  riskAcceptance_requestedBy    RiskAcceptance[]        @relation("RiskAcceptance_requestedBy")
  riskAcceptance_decidedBy      RiskAcceptance[]        @relation("RiskAcceptance_decidedBy")
  finding_assignedTo            Finding[]               @relation("Finding_assignedTo")
  remediationTask_ownerId       RemediationTask[]       @relation("RemediationTask_ownerId")
  vendor_businessOwnerId        Vendor[]                @relation("Vendor_businessOwnerId")
  vendorAssessment_assessorId   VendorAssessment[]      @relation("VendorAssessment_assessorId")
  aiSystem_businessOwnerId      AiSystem[]              @relation("AiSystem_businessOwnerId")
  aiSystem_technicalOwnerId     AiSystem[]              @relation("AiSystem_technicalOwnerId")
  aiSystem_riskOwnerId          AiSystem[]              @relation("AiSystem_riskOwnerId")
  aiAssessment_approvedBy       AiAssessment[]          @relation("AiAssessment_approvedBy")
  notification_recipientUserId  Notification[]          @relation("Notification_recipientUserId")
  auditEvent_actorUserId        AuditEvent[]            @relation("AuditEvent_actorUserId")

  @@map("users")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(active)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String
  isSystem    Boolean @default(true) @map("is_system")

  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  csrfTokenHash        String    @map("csrf_token_hash")
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt        DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt    DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason        String?   @map("revoked_reason")
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  normalizedEmail String    @map("normalized_email")
  roleKeys        String[]  @map("role_keys")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  inviterId       String    @map("inviter_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  // generated relations (scripts/add-column-maps.mjs)
  inviterRef User @relation("Invitation_inviterId", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("invitations")
}

// ───────────────────────── Frameworks & controls ─────────────────────────

model Framework {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String?         @map("organization_id") @db.Uuid // null = platform reference framework
  key              String // e.g. nist-csf
  name             String
  publisher        String
  version          String
  releaseDate      DateTime?       @map("release_date") @db.Date
  sourceUrl        String?         @map("source_url")
  retrievedAt      DateTime?       @map("retrieved_at") @db.Date
  licenseNotes     String?         @map("license_notes")
  description      String?
  status           FrameworkStatus @default(active)
  isIllustrative   Boolean         @default(true) @map("is_illustrative")
  importProvenance Json            @default("{}") @map("import_provenance")
  importedAt       DateTime        @default(now()) @map("imported_at") @db.Timestamptz(6)
  importedBy       String?         @map("imported_by") @db.Uuid

  requirements FrameworkRequirement[]

  // generated back-relations
  aiAssessment_frameworkId AiAssessment[] @relation("AiAssessment_frameworkId")

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key, version])
  @@map("frameworks")
}

model FrameworkRequirement {
  id                String   @id @default(uuid()) @db.Uuid
  frameworkId       String   @map("framework_id") @db.Uuid
  requirementCode   String   @map("requirement_code")
  parentCode        String?  @map("parent_code")
  groupName         String?  @map("group_name") // e.g. CSF function "Govern", AI RMF function "Map"
  title             String
  summary           String? // internal summary, not official text unless licensed
  officialReference String?  @map("official_reference")
  sourceVersion     String   @map("source_version")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  framework Framework @relation(fields: [frameworkId], references: [id])

  // generated back-relations
  controlMapping_sourceRequirementId ControlMapping[] @relation("ControlMapping_sourceRequirementId")
  controlMapping_targetRequirementId ControlMapping[] @relation("ControlMapping_targetRequirementId")

  @@unique([frameworkId, requirementCode])
  @@map("framework_requirements")
}

model Control {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String?  @map("organization_id") @db.Uuid // null = platform template
  controlCode         String   @map("control_code")
  title               String
  description         String
  category            String
  templateConfig      Json?    @map("template_config") // platform templates only: suggested test rules and requirement refs
  isIllustrative      Boolean  @default(true) @map("is_illustrative")
  reviewFrequencyDays Int      @default(90) @map("review_frequency_days")
  active              Boolean  @default(true)
  version             Int      @default(1)
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  implementations ControlImplementation[]
  tests           ControlTest[]
  testConfigs     ControlTestConfig[]
  mappings        ControlMapping[]

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // generated back-relations
  riskControl_controlId RiskControl[] @relation("RiskControl_controlId")
  finding_controlId     Finding[]     @relation("Finding_controlId")

  @@unique([organizationId, controlCode])
  @@index([organizationId, category])
  @@map("controls")
}

model ControlMapping {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String?      @map("organization_id") @db.Uuid // null = platform-level illustrative mapping
  sourceRequirementId String       @map("source_requirement_id") @db.Uuid
  targetRequirementId String?      @map("target_requirement_id") @db.Uuid
  controlId           String?      @map("control_id") @db.Uuid
  mappingType         MappingType  @map("mapping_type")
  rationale           String
  confidence          Int          @default(50) // 0-100 reviewer confidence
  reviewStatus        ReviewStatus @default(unreviewed) @map("review_status")
  reviewedBy          String?      @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes         String?      @map("review_notes")
  sourceReference     String?      @map("source_reference")
  frameworkVersion    String       @map("framework_version")
  isIllustrative      Boolean      @default(true) @map("is_illustrative")
  version             Int          @default(1)
  createdBy           String?      @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  control Control?                @relation(fields: [controlId], references: [id])
  history ControlMappingHistory[]

  // generated relations (scripts/add-column-maps.mjs)
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceRequirementRef FrameworkRequirement  @relation("ControlMapping_sourceRequirementId", fields: [sourceRequirementId], references: [id], onDelete: Restrict)
  targetRequirementRef FrameworkRequirement? @relation("ControlMapping_targetRequirementId", fields: [targetRequirementId], references: [id], onDelete: Restrict)

  @@index([organizationId, reviewStatus])
  @@index([sourceRequirementId])
  @@index([controlId])
  @@map("control_mappings")
}

model ControlMappingHistory {
  id             String   @id @default(uuid()) @db.Uuid
  mappingId      String   @map("mapping_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  previousValues Json     @map("previous_values")
  newValues      Json     @map("new_values")
  changedBy      String?  @map("changed_by") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  rationale      String?

  mapping ControlMapping @relation(fields: [mappingId], references: [id])

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([mappingId])
  @@map("control_mapping_history")
}

model ControlImplementation {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  controlId              String               @map("control_id") @db.Uuid
  ownerId                String?              @map("owner_id") @db.Uuid
  status                 ImplementationStatus @default(not_assessed)
  applicabilityRationale String?              @map("applicability_rationale")
  soaIncluded            Boolean              @default(true) @map("soa_included") // ISO 27001 Statement of Applicability
  soaJustification       String?              @map("soa_justification")
  implementationNotes    String?              @map("implementation_notes")
  lastReviewedAt         DateTime?            @map("last_reviewed_at") @db.Timestamptz(6)
  nextReviewAt           DateTime?            @map("next_review_at") @db.Timestamptz(6)
  version                Int                  @default(1)
  updatedBy              String?              @map("updated_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  control Control @relation(fields: [controlId], references: [id])

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerRef     User?        @relation("ControlImplementation_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, controlId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, nextReviewAt])
  @@map("control_implementations")
}

model ControlTestConfig {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  controlId      String    @map("control_id") @db.Uuid
  ruleKey        String    @map("rule_key")
  parameters     Json      @default("{}")
  frequencyHours Int       @default(24) @map("frequency_hours")
  enabled        Boolean   @default(true)
  integrationId  String?   @map("integration_id") @db.Uuid
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  control Control @relation(fields: [controlId], references: [id])

  // generated relations (scripts/add-column-maps.mjs)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, controlId, ruleKey])
  @@index([organizationId, enabled, nextRunAt])
  @@map("control_test_configs")
}

model ControlTest {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  controlId           String     @map("control_id") @db.Uuid
  configId            String?    @map("config_id") @db.Uuid
  testType            TestType   @map("test_type")
  ruleKey             String?    @map("rule_key")
  testRuleVersion     String?    @map("test_rule_version")
  result              TestResult
  summary             String
  details             Json       @default("{}")
  evidenceIds         String[]   @map("evidence_ids") @db.Uuid
  manualRationale     String?    @map("manual_rationale")
  startedAt           DateTime   @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?  @map("completed_at") @db.Timestamptz(6)
  initiatedBy         String?    @map("initiated_by") @db.Uuid
  sourceIntegrationId String?    @map("source_integration_id") @db.Uuid
  evidenceSnapshot    Json       @default("{}") @map("evidence_snapshot")
  findingId           String?    @map("finding_id") @db.Uuid
  workflowRunId       String?    @map("workflow_run_id") @db.Uuid
  correlationId       String     @map("correlation_id")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  control Control @relation(fields: [controlId], references: [id])

  // generated relations (scripts/add-column-maps.mjs)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiatedByRef User?        @relation("ControlTest_initiatedBy", fields: [initiatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, controlId, completedAt])
  @@index([organizationId, result])
  @@map("control_tests")
}

// ─────────────────────────────── Evidence ───────────────────────────────

model Evidence {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  title            String
  description      String?
  storageKey       String?                @unique @map("storage_key") // null for metadata-only records
  originalFilename String?                @map("original_filename")
  mediaType        String?                @map("media_type")
  sizeBytes        BigInt?                @map("size_bytes")
  sha256Checksum   String?                @map("sha256_checksum")
  sourceType       EvidenceSourceType     @map("source_type")
  sourceUri        String?                @map("source_uri")
  collectedAt      DateTime?              @map("collected_at") @db.Timestamptz(6)
  validFrom        DateTime?              @map("valid_from") @db.Timestamptz(6)
  expiresAt        DateTime?              @map("expires_at") @db.Timestamptz(6)
  classification   EvidenceClassification @default(internal)
  ownerId          String?                @map("owner_id") @db.Uuid
  uploadedBy       String?                @map("uploaded_by") @db.Uuid
  reviewStatus     ReviewStatus           @default(pending_review) @map("review_status")
  reviewedBy       String?                @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes      String?                @map("review_notes")
  scanStatus       String                 @default("not_scanned") @map("scan_status") // virus-scan hook, not enabled until configured
