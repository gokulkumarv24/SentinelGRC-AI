{
  "name": "@sentinelgrc/api",
  "version": "0.0.1",
  "description": "SentinelGRC AI REST API and worker (NestJS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:api": "vitest run --config ./vitest.config.e2e.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:schema": "node scripts/add-column-maps.mjs && prisma format && node scripts/add-column-maps.mjs && prisma format && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "seed:demo": "node dist/cli/seed-demo.js",
    "admin:create": "node dist/cli/create-admin.js",
    "openapi": "node dist/cli/export-openapi.js",
    "postinstall": "prisma generate",
    "reference:sync": "node dist/cli/sync-reference.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "aws4fetch": "1.0.20",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "13.2.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
