{
  "key": "vendor-security",
  "name": "Vendor security assessment",
  "version": 1,
  "purpose": "vendor_security",
  "description": "Baseline security questionnaire for third parties that handle company data or access company systems. Written for this project; adapt it to your policies.",
  "questions": [
    { "questionKey": "gov.policy", "category": "governance", "questionText": "Do you maintain an approved information security policy reviewed at least annually?", "responseType": "yes_no", "required": true, "weight": 2, "important": true, "evidenceRequired": true, "expectedAnswer": { "equals": true }, "guidance": "Attach the policy or its table of contents with the approval date." },
    { "questionKey": "gov.certification", "category": "governance", "questionText": "Which independent security attestations or certifications do you currently hold?", "responseType": "multiple_choice", "options": ["SOC 2 Type II", "ISO/IEC 27001", "ISO/IEC 27701", "PCI DSS", "None"], "required": true, "weight": 2, "evidenceRequired": false, "expectedAnswer": null, "guidance": "Informational. Reports are reviewed separately." },
    { "questionKey": "gov.certification_report", "category": "governance", "questionText": "Provide your most recent attestation report or certificate.", "responseType": "file", "required": true, "weight": 2, "evidenceRequired": true, "expectedAnswer": { "notEmpty": true }, "dependsOnQuestionKey": "gov.certification", "dependsOnAnswer": { "notIncludes": "None" } },
    { "questionKey": "iam.mfa", "category": "access_control", "questionText": "Is multi-factor authentication enforced for all workforce access to systems that process our data?", "responseType": "yes_no", "required": true, "weight": 3, "important": true, "evidenceRequired": true, "expectedAnswer": { "equals": true } },
    { "questionKey": "iam.reviews", "category": "access_control", "questionText": "How often are user access rights to those systems reviewed?", "responseType": "single_choice", "options": ["Monthly", "Quarterly", "Annually", "Not reviewed"], "required": true, "weight": 2, "evidenceRequired": false, "expectedAnswer": { "in": ["Monthly", "Quarterly"] } },
    { "questionKey": "enc.at_rest", "category": "encryption", "questionText": "Is our data encrypted at rest?", "responseType": "yes_no", "required": true, "weight": 3, "important": true, "evidenceRequired": false, "expectedAnswer": { "equals": true } },
    { "questionKey": "enc.in_transit", "category": "encryption", "questionText": "Is our data encrypted in transit with TLS 1.2 or later?", "responseType": "yes_no", "required": true, "weight": 3, "evidenceRequired": false, "expectedAnswer": { "equals": true } },
    { "questionKey": "vuln.pentest_date", "category": "vulnerability_management", "questionText": "When was your last independent penetration test of the service?", "responseType": "date", "required": true, "weight": 2, "evidenceRequired": true, "expectedAnswer": { "withinDays": 365 }, "guidance": "Provide the executive summary of the report." },
    { "questionKey": "vuln.critical_sla", "category": "vulnerability_management", "questionText": "Maximum number of days to remediate a critical vulnerability?", "responseType": "number", "required": true, "weight": 2, "evidenceRequired": false, "expectedAnswer": { "max": 30 } },
    { "questionKey": "ir.plan", "category": "incident_response", "questionText": "Do you have a tested incident response plan?", "responseType": "yes_no", "required": true, "weight": 2, "evidenceRequired": true, "expectedAnswer": { "equals": true } },
    { "questionKey": "ir.notify_hours", "category": "incident_response", "questionText": "Within how many hours will you notify us of a security incident affecting our data?", "responseType": "number", "required": true, "weight": 3, "important": true, "evidenceRequired": false, "expectedAnswer": { "max": 72 } },
    { "questionKey": "bc.backup_test", "category": "business_continuity", "questionText": "Are backups of our data restore-tested at least twice a year?", "responseType": "yes_no", "required": true, "weight": 2, "evidenceRequired": false, "expectedAnswer": { "equals": true } },
    { "questionKey": "bc.rto", "category": "business_continuity", "questionText": "Committed recovery time objective (hours) for the service?", "responseType": "number", "required": false, "weight": 1, "evidenceRequired": false, "expectedAnswer": { "max": 24 } },
    { "questionKey": "priv.dpa", "category": "privacy", "questionText": "Will you sign a data processing agreement covering personal data you process for us?", "responseType": "yes_no", "required": true, "weight": 2, "important": true, "evidenceRequired": false, "expectedAnswer": { "equals": true } },
    { "questionKey": "sub.list", "category": "subcontractors", "questionText": "Do you use subprocessors that can access our data?", "responseType": "yes_no", "required": true, "weight": 1, "evidenceRequired": false, "expectedAnswer": null },
    { "questionKey": "sub.flowdown", "category": "subcontractors", "questionText": "Are equivalent security obligations contractually flowed down to those subprocessors?", "responseType": "yes_no", "required": true, "weight": 2, "evidenceRequired": false, "expectedAnswer": { "equals": true }, "dependsOnQuestionKey": "sub.list", "dependsOnAnswer": { "equals": true } },
    { "questionKey": "loc.regions", "category": "data_location", "questionText": "In which regions is our data stored or processed?", "responseType": "multiple_choice", "options": ["EU/EEA", "Switzerland", "United Kingdom", "United States", "Asia-Pacific", "Other"], "required": true, "weight": 1, "evidenceRequired": false, "expectedAnswer": null },
    { "questionKey": "dev.sdlc", "category": "secure_development", "questionText": "Describe your secure development practices (code review, dependency scanning, security testing).", "responseType": "text", "required": true, "weight": 2, "evidenceRequired": false, "expectedAnswer": { "notEmpty": true } },
    { "questionKey": "ai.usage", "category": "ai_usage", "questionText": "Does the service use AI or machine-learning models to process our data?", "responseType": "yes_no", "required": true, "weight": 1, "evidenceRequired": false, "expectedAnswer": null },
    { "questionKey": "ai.training", "category": "ai_usage", "questionText": "Is our data excluded from training or improving models that serve other customers?", "responseType": "yes_no", "required": true, "weight": 3, "important": true, "evidenceRequired": false, "expectedAnswer": { "equals": true }, "dependsOnQuestionKey": "ai.usage", "dependsOnAnswer": { "equals": true } },
    { "questionKey": "ai.human_oversight", "category": "ai_usage", "questionText": "Describe how humans oversee or can override AI-produced outputs that affect us.", "responseType": "text", "required": false, "weight": 1, "evidenceRequired": false, "expectedAnswer": { "notEmpty": true }, "dependsOnQuestionKey": "ai.usage", "dependsOnAnswer": { "equals": true } }
  ]
}
