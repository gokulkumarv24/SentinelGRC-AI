# SentinelGRC AI — environment configuration (spec §21.2).
# Copy to `.env` at the repository root and fill in values. Placeholders only — never commit real secrets.

# ── Application ──
APP_ENV=development                 # development | test | production
APP_NAME="SentinelGRC AI"
PUBLIC_APP_URL=http://localhost:3000 # browser-facing URL of the web app
API_BASE_URL=http://localhost:4000   # where the web server reaches the API (server-side only)
API_PORT=4000
LOG_LEVEL=info                       # fatal | error | warn | info | debug

# ── Database ──
# Local (no Docker): run `npm run db:local -w services/api`, then use the URLs below.
# Hosted (Neon): use the *pooled* connection string of the main branch for DATABASE_URL
# and the `test` branch for TEST_DATABASE_URL.
DATABASE_URL=postgresql://sentinel:CHANGE_ME@127.0.0.1:54329/sentinelgrc_dev
TEST_DATABASE_URL=postgresql://sentinel:CHANGE_ME@127.0.0.1:54329/sentinelgrc_test

# ── Sessions & security ──
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist; never * in production
TRUST_PROXY=false                    # true behind one TLS proxy; cloudflare on Render; private for other PaaS
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# ── Evidence storage ──
STORAGE_BACKEND=local                # local | s3
LOCAL_STORAGE_PATH=./var/storage     # relative to repo root; outside any public web root
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID_REF=                # name of the secret holding the key, not the key itself
S3_SECRET_ACCESS_KEY_REF=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
DOWNLOAD_URL_TTL_SECONDS=300

# ── AI assistant (advisory only) ──
AI_ENABLED=false                     # master switch; the product works fully with AI disabled
AI_PROVIDER=mock                     # mock | openai-compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=                          # e.g. Groq key (gsk_...). Server-side only.
AI_DATA_SHARING_APPROVED=false       # must be true before any content is sent to an external provider
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=24000

# ── Email (optional; in-app notifications always work) ──
EMAIL_PROVIDER=none                  # none | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SentinelGRC <no-reply@example.invalid>"
EMAIL_ALLOWED_RECIPIENT_DOMAINS=     # in demo mode, only these domains receive email

# ── Observability ──
SENTRY_DSN=                          # optional error monitoring endpoint

# ── Demo / seed ──
DEMO_MODE=true                       # enables the demo seed command; must be false in production
WORKER_ENABLED=true                  # run scheduler in the worker process
WORKER_POLL_SECONDS=15               # how often the worker looks for due schedules, queued runs and email
